# 解球 API 环境变量示例
# 本地开发建议直接连 Postgres；SQLite 仅用于一次性工具。

JQ_ENV=development
# 生产/本地统一自建 Postgres 16；SQLite 仅用于纯单元测试
JQ_DATABASE_URL=postgresql+psycopg2://jieqiu:jieqiu_dev_password@localhost:5433/jieqiu
JQ_DB_POOL_SIZE=10
JQ_DB_MAX_OVERFLOW=20
JQ_DB_POOL_TIMEOUT_SECONDS=30
JQ_DB_POOL_RECYCLE_SECONDS=1800
JQ_DB_STATEMENT_TIMEOUT_MS=15000
JQ_DB_LOCK_TIMEOUT_MS=5000
JQ_XG_DATA_PATH=./xg_matches.csv
JQ_XG_EXTRA_DIR=./xg_dumps
JQ_JWT_SECRET=change-me
JQ_CONSOLE_PASSWORD=change-me
JQ_FREEZE_BASELINE=./freeze_baseline.json
JQ_CORS_EXTRA_ORIGINS=http://localhost:8081,http://43.128.24.244:8899

# 助理运行时
JQ_DAILY_BRIEF_HOUR=19

# JPush：未配置时 worker 自动 dry-run
JQ_JPUSH_APPKEY=
JQ_JPUSH_MASTER_SECRET=
JQ_JPUSH_DRYRUN=1

# 数据保留（天）；app.db_maint 默认 dry-run
JQ_EVENT_RETENTION_DAYS=90
JQ_NOTIFICATION_RETENTION_DAYS=180
JQ_MODEL_RUN_RETENTION_DAYS=365
JQ_USER_EVENT_RETENTION_DAYS=180
JQ_VERIFICATION_CODE_RETENTION_DAYS=7
