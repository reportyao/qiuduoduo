# 解球 API 环境变量示例
# 本地开发建议直接连 Postgres；SQLite 仅用于一次性工具。

JQ_ENV=dev
# 生产/本地统一自建 Postgres 16；SQLite 仅用于纯单元测试
JQ_DATABASE_URL=postgresql+psycopg2://jieqiu:jieqiu_dev_password@localhost:5433/jieqiu
JQ_DB_POOL_SIZE=10
JQ_DB_MAX_OVERFLOW=20
JQ_DB_POOL_TIMEOUT_SECONDS=30
JQ_DB_POOL_RECYCLE_SECONDS=1800
JQ_DB_STATEMENT_TIMEOUT_MS=15000
JQ_DB_LOCK_TIMEOUT_MS=5000
JQ_XG_DATA_PATH=./xg_matches.csv
JQ_XG_EXTRA_DIR=./xg_dumps
JQ_JWT_SECRET=change-me
# 仅 dev/test 允许 stub；生产必须配置真实通道
JQ_AUTH_STUB=false
JQ_ADMIN_PASSWORD=change-me-too
JQ_FREEZE_BASELINE=./freeze_baseline.json
JQ_CORS_EXTRA_ORIGINS=http://localhost:8081,http://43.128.24.244:8899

# 助理运行时
JQ_DAILY_BRIEF_HOUR=19
# 数据脉搏展示系数：默认 3，上限 5；只乘数据点，不乘场次/封存/准确率
JQ_PULSE_DISPLAY_FACTOR=3

# API-Football（免费档 100 请求/日；默认只用 90）
JQ_API_FOOTBALL_KEY=
# apisports=官方直连；rapidapi=RapidAPI 市场（需已订阅 API-Football）
JQ_API_FOOTBALL_PROVIDER=apisports
JQ_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
JQ_API_FOOTBALL_RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
JQ_API_FOOTBALL_DAILY_LIMIT=90
JQ_API_FOOTBALL_LINEUP_HOURS=6
JQ_API_FOOTBALL_MAX_REQUESTS_PER_RUN=20

# 国际盘（The Odds API）；不配则市闸全 pending，推荐主链不会产出 published
# 实际 sport key 按当日竞彩联赛动态选择；JQ_ODDS_SPORTS 仅作兜底
JQ_ODDS_API_KEY=
JQ_ODDS_SYNC_MIN_INTERVAL_HOURS=18
JQ_ODDS_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_europa_conference_league

# LLM Gateway（fast=免费/低成本；deep=DeepSeek；未配置 Key → 模板兜底）
JQ_LLM_FAST_PROVIDER=glm
JQ_LLM_FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JQ_LLM_FAST_MODEL=glm-4-flash
JQ_LLM_FAST_API_KEY=
JQ_LLM_FAST_INPUT_PRICE_CNY_PER_M=0
JQ_LLM_FAST_OUTPUT_PRICE_CNY_PER_M=0
JQ_LLM_DEEP_PROVIDER=deepseek
JQ_LLM_DEEP_BASE_URL=https://api.deepseek.com/v1
JQ_LLM_DEEP_MODEL=deepseek-chat
JQ_LLM_DEEP_API_KEY=
JQ_LLM_DEEP_INPUT_PRICE_CNY_PER_M=2
JQ_LLM_DEEP_OUTPUT_PRICE_CNY_PER_M=8
JQ_LLM_TIMEOUT_S=20
JQ_LLM_MAX_RETRIES=1
JQ_LLM_DAILY_BUDGET_CNY=50
JQ_LLM_TASK_BUDGET_CNY=20
JQ_LLM_USER_DAILY_CALLS=50
JQ_LLM_CACHE_TTL_SECONDS=1800
JQ_LLM_REVIEW_MAX_TOKENS=1600

# JPush：未配置时 worker 自动 dry-run
JQ_JPUSH_APPKEY=
JQ_JPUSH_MASTER_SECRET=
JQ_JPUSH_DRYRUN=1

# 数据保留（天）；app.db_maint 默认 dry-run
JQ_EVENT_RETENTION_DAYS=90
JQ_NOTIFICATION_RETENTION_DAYS=180
JQ_MODEL_RUN_RETENTION_DAYS=365
JQ_USER_EVENT_RETENTION_DAYS=180
JQ_INTERACTION_RETENTION_DAYS=180
JQ_LLM_USAGE_RETENTION_DAYS=180
JQ_PERSONA_COPY_RETENTION_DAYS=30
JQ_VERIFICATION_CODE_RETENTION_DAYS=7

# 人设语气翻译模型池（OpenAI-compatible /chat/completions）
JQ_PERSONA_LLM_BASE_URL=https://tokenrhythm.studio/v1
JQ_PERSONA_LLM_API_KEY=
JQ_PERSONA_LLM_ENC_KEY=
JQ_PERSONA_LLM_TIMEOUT_S=20
JQ_PERSONA_LLM_MAX_TOKENS=800
JQ_PERSONA_LLM_TEMPERATURE=0.4
