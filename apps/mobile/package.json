    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
