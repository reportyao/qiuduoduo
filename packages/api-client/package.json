{
  "name": "@jieqiu/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "generate:url": "openapi-typescript http://127.0.0.1:8100/openapi.json -o src/schema.d.ts",
    "generate:staging": "openapi-typescript https://staging-api.jieqiu.example/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.6.3"
  }
}
